	$(MAKE) $(MAKESILENT) -f CMakeFiles/redgui.dir/build.make CMakeFiles/redgui.dir/src/ColorSpace.cu.i
.PHONY : src/ColorSpace.cu.i

src/ColorSpace.s: src/ColorSpace.cu.s
.PHONY : src/ColorSpace.s

