  "masks": [
    {
      "id": "operating-system-chrome",
      "reason": "Both golden images are app-produced client/framebuffer surfaces and contain no operating-system chrome.",
      "scope": "none"
    },
    {
      "id": "font-raster",
      "reason": "Roboto/Fork Awesome rasterization differs between Metal and OpenGL. Text content and anchors are checked from the ImGui semantic snapshot instead.",
      "scope": "ImGui text glyph pixels outside scientific media"
    },
    {
      "id": "backend-and-deferred-panels",
      "reason": "Backend diagnostics and write/inference controls are platform adapters or explicitly deferred. Window role, ordering, visibility, and outer bounds remain exact checks.",
      "scope": "File Browser, Frame Inspect, Diagnostics, buffer list, stimulus timeline, and analysis timeline interiors"
    },
    {
      "id": "camera-plot-decoration",
      "reason": "Maintained redgui owns ImPlot axes while the Metal adapter records the fitted media rectangle directly.",
      "scope": "Linux camera plot area outside viewports.camera_media"
    },
    {
      "id": "camera-picture-in-picture",
      "reason": "ROI/stimulus insets and their text labels use renderer-specific raster paths. Their availability and geometry are separately asserted by state markers.",
      "scope": "Camera areas outside the declared clean source regions"
    },
    {
      "id": "production-overlay-label-raster",
      "reason": "At this display scale the scientific subject occupies fewer than 20 pixels and is obscured by renderer-owned labels/insets. Frozen mask IoU, vector coverage, outlier, and channel thresholds are enforced by apple_read_only_overlay_metal_tests at a controlled resolution; Linux enforces the same source geometry contract in overlay_scene_contract_tests.",
      "scope": "Production camera overlay labels and small on-screen mask/vector raster"
    }
  ],
  "passed": true,
  "required_threshold_fixtures": [
    "overlay_scene_contract_tests",
    "apple_read_only_overlay_metal_tests"
  ],
  "schema": "crimson.phase5l.visual-acceptance-report.v1"
}
